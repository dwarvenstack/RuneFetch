# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.local

# ── PyInstaller build artefacts ───────────────────────────────
build/
dist/
*.spec
*.spec.bak

# ── Distribution / packaging ──────────────────────────────────
*.egg-info/
*.egg
MANIFEST
dist/
.eggs/
wheels/

# ── Testing ───────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── IDEs / local agent tooling ───────────────────────────────
.vscode/
.idea/
.claude/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────────────
*~
.fuse_hidden*
.nfs*

# ── RuneFetch user data (never commit personal data) ──────────
# Config and history live in ~/.runefetch/ but guard against
# anyone accidentally dropping them into the project root.
config.json
runefetch_history.json
queue_state.json
*.runefetch.json

# ── Bundled binaries (yt-dlp, ffmpeg — downloaded at runtime) ─
tools/
ffmpeg.zip
ffmpeg-*.zip
ffmpeg.exe
ffmpeg
ffprobe
ffprobe.exe
yt-dlp.exe
yt-dlp

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Temp / partial downloads ──────────────────────────────────
*.part[0-9]*
*.ytdl
*.tmp

# ── Browser extension — packed artefact only, not source ─────
browser_extension/*.crx
browser_extension/*.pem
browser_extension/*.zip

# ── Secrets (never commit tokens or keys) ────────────────────
*.pem
*.key
*.p12
.secrets
secrets.json

# ── Node (if web tooling ever added) ─────────────────────────
node_modules/
package-lock.json
yarn.lock

# ── Packaging / installer (build-machine only, never commit) ─
RuneFetch_Setup.iss
build_exe.bat
README.txt
hooks/
rthooks/

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.orig
*.swp
.DS_Store
