# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.local

# ── PyInstaller build artefacts ───────────────────────────────
build/
dist/
*.spec.bak

# ── Distribution / packaging ──────────────────────────────────
*.egg-info/
*.egg
MANIFEST
dist/
.eggs/
wheels/

# ── Testing ───────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────────────
*~
.fuse_hidden*
.nfs*

# ── RuneFetch user data (never commit personal data) ──────────
# Config and history live in ~/.runefetch/ but guard against
# anyone accidentally dropping them into the project root.
config.json
runefetch_history.json
queue_state.json
*.runefetch.json

# ── ffmpeg auto-downloaded bundle ────────────────────────────
ffmpeg.zip
ffmpeg-*.zip
ffmpeg.exe
ffmpeg
ffprobe
ffprobe.exe

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Temp / partial downloads ──────────────────────────────────
*.part[0-9]*
*.ytdl
*.tmp

# ── Browser extension — packed artefact only, not source ─────
browser_extension/*.crx
browser_extension/*.pem
browser_extension/*.zip

# ── Secrets (never commit tokens or keys) ────────────────────
*.pem
*.key
*.p12
.secrets
secrets.json
